# ============================================================
# Environment - {{ app_name }} (Mode: Full stack, DB lokal)
# Salin file ini menjadi .env dan isi nilai yang sesuai
# ============================================================

# --- Application ---
APP_NAME={{ app_name }}
APP_ENV=production
APP_DEBUG=false
APP_URL=https://{{ domain }}
APP_PORT={{ port }}

# --- Database (lokal, service: db) ---
DB_HOST=db
DB_PORT={{ db_port if db_port else '5432' }}
DB_DATABASE={{ app_name_safe }}
DB_USER={{ app_name_safe }}
DB_PASSWORD=change-me
{% if db_type in ['mysql', 'mariadb'] %}
DB_ROOT_PASSWORD=change-me-root
{% endif %}

{% if enable_sso %}
# --- SSO ({{ sso_provider_label }}) ---
{% for key, value in sso_env.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
