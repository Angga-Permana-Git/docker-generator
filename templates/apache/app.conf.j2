# ============================================================
# Apache Virtual Host - {{ app_name }} reverse proxy
# Security hardened: SSL, headers, rate limits, request limits
# ============================================================

# ---------- Global security ----------
ServerTokens Prod
ServerSignature Off
TraceEnable off

# ---------- HTTP -> HTTPS redirect ----------
<VirtualHost *:80>
    ServerName {{ domain }}
    Redirect permanent / https://{{ domain }}/
</VirtualHost>

# ---------- HTTPS ----------
<VirtualHost *:443>
    ServerName {{ domain }}

    # Catatan: direktif root folder sengaja TIDAK dipakai karena ini pure reverse proxy.
    # Semua request di-forward ke service 'app'.

    # --- Reverse proxy ke app service ---
    ProxyPreserveHost On
    ProxyRequests Off
    ProxyPass / http://app:{{ port }}/
    ProxyPassReverse / http://app:{{ port }}/

    # --- Timeout proxy ---
    ProxyTimeout 60
    Timeout 60

    # --- SSL Configuration (strong) ---
    SSLEngine on
    SSLCertificateFile /usr/local/apache2/conf/ssl/cert.crt
    SSLCertificateKeyFile /usr/local/apache2/conf/ssl/cert.key
    SSLProtocol all -SSLv2 -SSLv3 -TLSv1 -TLSv1.1
    SSLCipherSuite ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    SSLHonorCipherOrder on

    # --- Security Headers ---
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # --- Request Size Limits (10MB) ---
    LimitRequestBody 10485760

    # --- Disable directory listing ---
    Options -Indexes

    # --- Logging ---
    ErrorLog /proc/self/fd/2
    CustomLog /proc/self/fd/1 combined

    # --- Hide server info ---
    ServerTokens Prod
    ServerSignature Off
</VirtualHost>
