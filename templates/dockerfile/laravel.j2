# syntax=docker/dockerfile:1
# ============================================================
# Dockerfile - Laravel (multi-stage + hardened) - {{ app_name }}
# URUTAN BUILD (kritis, banyak gagal di sini):
#   Stage 1 vendor (Composer) -> Stage 2 node (Vite) -> Stage 3 runtime
# Security: tini init, non-root (www-data), permission ketat,
#           .env TIDAK di-bake ke image (dipasang via compose env_file)
# ============================================================

# ---------- STAGE 1: vendor (Composer) ----------
FROM composer:2 AS vendor
WORKDIR /app
# Salin manifest dulu untuk layer caching (build lebih cepat)
COPY composer.json composer.lock* ./
# --ignore-platform-req menghindari gagal karena versi PHP/ext host
RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-ansi \
        --no-scripts \
        --optimize-autoloader \
        --ignore-platform-req=php \
        --ignore-platform-req=ext-intl
# Salin seluruh kode lalu regenerate autoloader (ikut semua class app)
COPY . .
RUN composer dump-autoload --no-dev --optimize

# ---------- STAGE 2: node (Vite build) ----------
FROM node:22-alpine AS node
WORKDIR /app
# KUNCI: salin vendor dari stage Composer agar Vite bisa resolve
# path CSS Filament (resources/css/filament/admin/theme.css)
COPY --from=vendor /app/vendor ./vendor
COPY package.json package-lock.json* ./
COPY vite.config.* ./
COPY resources ./resources
COPY public ./public
RUN mkdir -p public \
    && npm install --no-audit --no-fund \
    && npm run build

# ---------- STAGE 3: runtime (PHP-FPM Alpine) ----------
FROM php:8.3-fpm-alpine AS runtime
ENV APP_DIR=/var/www/html

# tini (init system) + sistem deps + ekstensi PHP dalam SATU layer
RUN apk add --no-cache \
        tini \
        libzip-dev icu-dev oniguruma-dev \
        libpng-dev libjpeg-turbo-dev freetype-dev libwebp-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_mysql pdo_pgsql zip intl bcmath gd opcache exif pcntl mbstring \
    && apk del libzip-dev icu-dev oniguruma-dev \
        libpng-dev libjpeg-turbo-dev freetype-dev libwebp-dev \
    && rm -rf /var/cache/apk/*

WORKDIR $APP_DIR

# Salin kode aplikasi. .env TIDAK ikut (ada di .dockerignore) ->
# env dibaca dari compose (env_file), bukan di-bake ke image.
COPY . .

# Overlay hasil build dari stage sebelumnya
COPY --from=vendor /app/vendor ./vendor
COPY --from=node /app/public/build ./public/build

# Buat direktori writable + ownership www-data (user non-root PHP-FPM)
RUN mkdir -p \
        storage/framework/cache/data storage/framework/sessions \
        storage/framework/views storage/framework/testing \
        storage/logs storage/app/public storage/livewire-tmp \
    && chown -R www-data:www-data storage bootstrap/cache public \
    && chmod -R 775 storage bootstrap/cache

# Jika .env ikut ter-copy (misal user tidak pakai env_file), kunci permission
# agar hanya www-data yang bisa baca (tidak world-readable)
RUN touch $APP_DIR/.env && chown www-data:www-data $APP_DIR/.env && chmod 400 $APP_DIR/.env

# Switch ke user non-root
USER www-data

EXPOSE {{ port }}

# tini sebagai entrypoint, lalu php-fpm
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["php-fpm"]
