# ============================================================
# Dockerfile - React.js (static build) - {{ app_name }}
# Security hardened: non-root user, pinned versions, tini
# ============================================================

# ---------- STAGE 1: BUILD ----------
FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

RUN npm run build

# ---------- STAGE 2: RUNTIME (nginx) ----------
FROM nginx:1.25-alpine

# Install tini as init system
RUN apk add --no-cache tini

# Copy built static files
COPY --from=build /app/build /usr/share/nginx/html
COPY --from=build /app/dist /usr/share/nginx/html

# Remove default config, minimal hardened nginx
RUN rm -f /etc/nginx/conf.d/default.conf

# Create non-root user (UID 1001)
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    chown -R appuser:appgroup /usr/share/nginx/html /var/cache/nginx /var/log/nginx && \
    chmod -R 750 /usr/share/nginx/html

# Switch to non-root user
USER appuser

EXPOSE {{ port }}

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["nginx", "-g", "daemon off;"]
